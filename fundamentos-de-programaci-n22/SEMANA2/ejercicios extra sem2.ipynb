   ],
   "source": [
    "# Suma del 1 al 10\n",
    "total = 0\n",
    "for i in range(1, 11):\n",
    "    total = total + i\n",
    "print(f\"La suma del 1 al 10 es: {total}\")      # 55\n",
    "\n",
    "# Acumulador de pares\n",
    "suma_pares = 0\n",
    "for i in range(1, 11):\n",
    "    if i % 2 == 0:\n",
    "        suma_pares = suma_pares + i\n",
    "print(f\"La suma de los pares es: {suma_pares}\") # 2+4+6+8+10 = 30"
   ]
  },
