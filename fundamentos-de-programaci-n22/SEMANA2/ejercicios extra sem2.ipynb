   "source": [
    "# EXTRA 1: CONTROL DE AFORO CON BREAK Y CONTINUE (WHILE)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "7a0483a3",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Menor de 3 años, sin cargo\n",
      "Menor de 3 años, sin cargo\n",
      "Total a pagar: $100.00\n"
     ]
    }
   ],
   "source": [
    "total = 0\n",
    "contador = 1\n",
    "while True:\n",
    "    precio_boleto = int(input(f\"Precio del boleto {contador}: \"))\n",
    "\n",
    "    if(precio_boleto == 0):\n",
    "        print(\"Menor de 3 años, sin cargo\")\n",
    "        contador +=1\n",
    "        continue\n",
    "\n",
    "    contador += 1\n",
    "    total = total + precio_boleto\n",
    "    if total >= 100:\n",
    "        break\n",
    "print(f\"Total a pagar: ${total:.2f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "5cf5a029",
   "metadata": {},
   "source": [
